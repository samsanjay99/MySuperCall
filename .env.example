# MyCall environment variables (never commit real values)
# SECURITY: All secrets must come from environment variables only.
# If any Supabase credential was ever exposed (chat, source, git), ROTATE IT IMMEDIATELY
# in the Supabase dashboard (especially the database password and service_role key).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # public anon key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # SERVER ONLY - never send to client

# Existing
# PORT=3000
# NODE_ENV=production

# Never put real credentials here or in any code/chat.